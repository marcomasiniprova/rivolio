# Le chiavi vive stanno in .env.development.local (NON in .env.local: quel
# file è in UTF-16 e Next lo ignora, vedi STATO.md). Entrambi sono ignorati
# da git: i valori veri stanno SOLO lì. In produzione: variabili su Netlify.
#
# Questo file è il MODELLO: i nomi e a cosa servono, mai i valori. Rispecchia
# le variabili che il codice legge davvero (verificato il 30/08 con un grep di
# process.env). Le variabili che Netlify mette da sé — URL, DEPLOY_PRIME_URL,
# CONTEXT, BRANCH — non si scrivono qui.

# ===== SUPABASE (obbligatorie) =====
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=        # oppure NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=                  # la service_role. Senza, il server non tocca il database
DB_PASSWORD=                          # solo per le migrazioni a mano (facoltativa)

# ===== IL MOTORE (dati volo) =====
AERODATABOX_API_KEY=  # fonte primaria (RapidAPI). SENZA chiave gira il fornitore demo (voli ZZ)
AVIATIONEDGE_API_KEY= # seconda fonte per l'incrocio (facoltativa, preferita se c'è)
AVIATIONSTACK_API_KEY=# seconda fonte alternativa (facoltativa)
MOTORE_SEGRETO=       # protegge /api/motore/* in produzione (intestazione x-motore-segreto)
TETTO_FORNITORE_ORA=  # quante chiamate al fornitore all'ora, in tutto il sito (default 1000)

# ===== LA CASSA (Stripe Managed Payments: versa l'IVA al posto nostro) =====
STRIPE_SECRET_KEY=      # in locale la chiave di TEST (sk_test_...), mai la live
STRIPE_WEBHOOK_SECRET=  # firma del webhook. In produzione, senza, il webhook rifiuta tutto
MANAGED_PAYMENTS_ATTIVO=# "0" per spegnere Managed Payments (default: acceso)

# ===== EMAIL (Resend) =====
RESEND_API_KEY=
RESEND_MITTENTE=      # es. "Valerio dal team di Rivolio <team@send.rivolio.it>" (dominio verificato)
RESEND_RISPOSTA_A=    # l'indirizzo VERO che leggi tu (dove tornano i "Rispondi")
RESEND_HOOK_SECRET=   # gancio email di Supabase -> /api/posta-auth (facoltativo: si usa SMTP)

# ===== L'AI: controrisposta + OCR (carta d'imbarco e screenshot) =====
OPENAI_API_KEY=       # il cervello (gpt-5.6-terra). Il cancello deterministico decide comunque
OPENAI_MODELLO=       # vuoto = gpt-5.6-terra. Cambia il modello senza toccare il codice
MISTRAL_API_KEY=      # rete di sicurezza durante il passaggio a OpenAI (facoltativa)

# ===== IL MURO DEL CHECK (nasce SPENTO) =====
NEXT_PUBLIC_CHECK_PREZZO_ATTIVO=   # "1" = il check si paga (1,99). Vuoto = gratis per tutti
# ⚠️ L'app mobile ha la SUA copia, EXPO_PUBLIC_CHECK_PREZZO_ATTIVO (in mobile/):
#    va tenuta allineata a questa, se no l'app promette gratis e il sito fa pagare.

# ===== FIRME E INTERRUTTORI =====
SEGRETO_ISCRITTI=     # firma i gettoni email e i pass del check. Se manca, in prod usa la service key
CLASSIFICA_ATTIVA=    # "1" accende la classifica (aspetta abbastanza vittorie vere)
RECUPERO_ATTIVO=      # "1" accende le email di recupero (chi controlla e non compra). Spento di default

# ===== NOTIFICHE SUL TELEFONO (Telegram): soldi e guasti =====
TELEGRAM_BOT_TOKEN=   # il gettone del bot @Rivolio_AI_bot
TELEGRAM_ADMIN_CHAT=  # il chat id dove arrivano gli avvisi
ALERT_EMAIL=          # allarmi anche via email (facoltativo: default il tuo indirizzo)

# ===== METEO self-hosted sul VPS (solo per smontare la scusa del maltempo) =====
OPENMETEO_URL=        # es. https://meteo.artecai.cloud. Spento senza la variabile
METEO_API_PASSWORD=   # password Basic dell'istanza. ⚠️ nel repo NON ci va mai
OPENMETEO_COMMERCIALE=# "1" per l'uso commerciale dell'archivio (facoltativo)

# ===== ERRORI (Sentry) =====
NEXT_PUBLIC_SENTRY_DSN=  # facoltativa: il DSN pubblico ha già un default nel codice
SENTRY_AUTH_TOKEN=       # facoltativa, solo al build: mappe del codice per stack trace leggibili

# ===== L'INDIRIZZO DEL SITO =====
NEXT_PUBLIC_SITO=     # es. https://rivolio.it. Se manca, il sito legge l'URL che gli dà Netlify
RIVOLIO_PROVA=        # "1" SOLO sul gemello di prova (staging): forza l'ambiente di prova a runtime
