# Le chiavi vive stanno in .env.development.local (NON in .env.local: quel
# file è in UTF-16 e Next lo ignora, vedi STATO.md). Entrambi sono ignorati
# da git: i valori veri stanno SOLO lì. In produzione: variabili su Netlify.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
DB_PASSWORD=

# Il motore di Rivolio
AERODATABOX_API_KEY=  # dati volo, fonte primaria (RapidAPI). SENZA chiave gira il fornitore demo
AVIATIONSTACK_API_KEY=  # dati volo, fonte di riserva (facoltativa)
MOTORE_SEGRETO=       # protegge /api/motore/* in produzione (intestazione x-motore-segreto)
SHADOW_MODE=1         # 1 = ogni verdetto idoneo aspetta la conferma umana in /admin (SPEC §4)

# Pagamenti (Polar, Merchant of Record)
POLAR_CHECKOUT_PRATICA=   # URL del checkout link "1 pratica 14,90"
POLAR_CHECKOUT_FAMIGLIA=  # URL del checkout link "famiglia 24,90"
# IL TEST DEI DUE PREZZI (9/08): i due prodotti a prezzo alto.
# Se mancano, il sito serve il listino di sempre a tutti: il test non parte
# ma non si rompe niente e nessuno finisce su una cassa che non esiste.
POLAR_CHECKOUT_PRATICA_B=  # URL del checkout link "Pratica 25" (24,90)
POLAR_CHECKOUT_FAMIGLIA_B= # URL del checkout link "Pratica famiglia 40" (39,90)
POLAR_WEBHOOK_SECRET=     # firma del webhook ordini
POLAR_ACCESS_TOKEN=       # per le API (rimborsi garanzia, più avanti)

# Consegna
RESEND_API_KEY=
RESEND_HOOK_SECRET=   # gancio "Send Email" di Supabase -> /api/posta-auth

# Dopo il dominio (facoltative)
# RESEND_MITTENTE=Rivolio <ciao@DOMINIO>
# NEXT_PUBLIC_SITO=https://rivoglio.netlify.app

# AI: scrive la controrisposta e legge le immagini (OCR carta d'imbarco e
# screenshot). Dal 27/08 il cervello è OpenAI (gpt-5.6-terra), che fa testo
# e vision. Il cancello deterministico resta: l'AI non decide mai il verdetto.
OPENAI_API_KEY=
OPENAI_MODELLO=                    # vuoto = gpt-5.6-terra. Cambia il modello senza toccare il codice
# MISTRAL: solo rete di sicurezza durante il passaggio. Si può togliere quando OpenAI è confermato.
MISTRAL_API_KEY=

# Il muro del check (nasce SPENTO)
NEXT_PUBLIC_CHECK_PREZZO_ATTIVO=   # "1" = il check si paga. Vuoto = gratis per tutti
CASSA_PROVA_SEGRETO=               # se c'è, la cassa di prova esiste (per collaudare il muro)
COLLAUDO_APERTO=                   # "1" = apre le casse di prova a chiunque (solo per provare)

# Firme e segreti di servizio
SEGRETO_ISCRITTI=   # firma i gettoni email e i pass del check. Se manca, in prod usa la service key
TETTO_FORNITORE_ORA=  # quante chiamate al fornitore all'ora, in tutto il sito (default 1000)
CLASSIFICA_ATTIVA=    # "1" accende la classifica (aspetta abbastanza vittorie vere)

# Notifiche sul telefono (Telegram): soldi e guasti
TELEGRAM_BOT_TOKEN=   # il gettone del bot @Rivolio_AI_bot
TELEGRAM_ADMIN_CHAT=  # il chat id dove arrivano gli avvisi
ALERT_EMAIL=          # allarmi anche via email (facoltativo: default il tuo indirizzo)

# Meteo self-hosted sul VPS (facoltativo, serve solo a smontare la scusa del maltempo)
OPENMETEO_URL=        # es. http://tuo-vps:8080. Spento senza la variabile

# Fonte volo di riserva (facoltativa, spenta senza chiave)
AVIATIONEDGE_API_KEY=

# Freno condiviso anti-abuso (Upstash Redis, facoltativo)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Eredità viaggi (il vecchio motore resta nel codice ma non gira più)
EXA_API_KEY=
